{
  "entities": {
    "UserPreferencesDoc": {
      "title": "UserPreferencesDoc",
      "description": "User personalization and interface preferences stored at /users/{userId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name chosen by the user",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredName": {
          "type": "string",
          "description": "How Spark should address the user",
          "minLength": 1,
          "maxLength": 60
        },
        "avatarUrl": {
          "type": "string",
          "description": "Profile avatar URL or CSS gradient token",
          "minLength": 1,
          "maxLength": 500
        },
        "theme": {
          "type": "string",
          "description": "Interface appearance mode",
          "enum": ["dark", "light", "system"]
        },
        "accentColor": {
          "type": "string",
          "description": "Interface accent color",
          "enum": ["violet", "blue", "cyan", "emerald"]
        },
        "language": {
          "type": "string",
          "description": "Interface language code",
          "enum": ["en", "es", "fr", "de", "ja"]
        },
        "soundEnabled": {
          "type": "boolean",
          "description": "Whether task completion sound is enabled"
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Preferred display currency",
          "enum": ["USD", "EUR", "GBP"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "userId",
        "displayName",
        "preferredName",
        "avatarUrl",
        "theme",
        "accentColor",
        "language",
        "soundEnabled",
        "defaultCurrency",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfoDoc": {
      "title": "UserPrivateInfoDoc",
      "description": "Isolated PII document for user email and verified PayPal connection metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "SearchAuditDoc": {
      "title": "SearchAuditDoc",
      "description": "Record of a real-data shopping query executed by the user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "verifiedResultCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "no_verified_results", "source_error"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "query", "verifiedResultCount", "status", "createdAt"]
    },
    "SavedProductDoc": {
      "title": "SavedProductDoc",
      "description": "Verified product saved by the user in /users/{userId}/savedProducts/{productId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "sourceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "merchant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "canonicalUrl": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "price": {
          "type": "number"
        },
        "priceStatus": {
          "type": "string",
          "enum": ["verified", "price_could_not_be_verified"]
        },
        "imageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "productId",
        "sourceId",
        "sourceName",
        "name",
        "merchant",
        "canonicalUrl",
        "currency",
        "price",
        "priceStatus",
        "imageUrl",
        "createdAt"
      ]
    },
    "ConversationDoc": {
      "title": "ConversationDoc",
      "description": "User shopping conversation thread metadata stored at /users/{userId}/conversations/{conversationId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "lastPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "turnCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "conversationId",
        "title",
        "lastPrompt",
        "turnCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PurchaseDoc": {
      "title": "PurchaseDoc",
      "description": "Authoritative purchase record created only after verified PayPal capture",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderReference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "paypalTransactionId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "sourceId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "merchant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "quantity": {
          "type": "integer"
        },
        "totalAmount": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "paypalOrderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "paypalCaptureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "declined", "failed", "cancelled", "refunded"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["COMPLETED", "PENDING", "DECLINED", "FAILED", "CANCELLED", "REFUNDED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "orderReference",
        "paypalTransactionId",
        "sourceId",
        "productId",
        "productName",
        "merchant",
        "quantity",
        "totalAmount",
        "currency",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentConnectionDoc": {
      "title": "PaymentConnectionDoc",
      "description": "Verified PayPal identity connection stored at /users/{userId}/paymentConnections/{providerId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "provider": {
          "type": "string",
          "enum": ["paypal"]
        },
        "paypalSubjectId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "payerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maskedEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "emailVerified": {
          "type": "boolean"
        },
        "verifiedAccount": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["connected", "disconnected"]
        },
        "connectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "provider",
        "paypalSubjectId",
        "payerId",
        "maskedEmail",
        "emailVerified",
        "verifiedAccount",
        "status",
        "connectedAt",
        "updatedAt"
      ]
    },
    "SandboxPaymentOrderDoc": {
      "title": "SandboxPaymentOrderDoc",
      "description": "Sandbox payment order stored at /users/{userId}/sandbox_payment_orders/{orderId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "paypal_order_id": { "type": "string", "minLength": 0, "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"] },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "AWAITING_USER_CONFIRMATION",
            "AWAITING_PAYPAL_APPROVAL",
            "APPROVED",
            "CAPTURE_PENDING",
            "COMPLETED",
            "DECLINED",
            "CANCELLED",
            "EXPIRED",
            "FAILED",
            "REFUNDED"
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": ["SANDBOX_SIMULATION", "MERCHANT_CHECKOUT"]
        },
        "authorization_hash": { "type": "string", "minLength": 0, "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "user_id",
        "product_id",
        "merchant_id",
        "amount",
        "currency",
        "status",
        "execution_mode",
        "created_at",
        "expires_at"
      ]
    },
    "SandboxPaymentCaptureDoc": {
      "title": "SandboxPaymentCaptureDoc",
      "description": "Sandbox payment capture stored at /users/{userId}/sandbox_payment_captures/{captureId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "order_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "paypal_capture_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"] },
        "capture_status": {
          "type": "string",
          "enum": ["COMPLETED", "DECLINED", "PENDING", "FAILED", "REFUNDED"]
        },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "user_id",
        "order_id",
        "paypal_capture_id",
        "amount",
        "currency",
        "capture_status",
        "created_at"
      ]
