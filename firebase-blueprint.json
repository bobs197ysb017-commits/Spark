        "planId": { "type": "string" },
        "status": { "type": "string" },
        "billingCycle": { "type": "string" },
        "monthlyPriceUsd": { "type": "number" },
        "paypalSubscriptionId": { "type": "string" },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
