    "UserUsageQuotaDoc": {
      "title": "UserUsageQuotaDoc",
      "description": "Atomic per-period quota and usage counters for a user stored under /users/{userId}/usage_quotas/{periodId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "periodId": { "type": "string", "description": "Billing period key (e.g. period-2026-11)" },
        "periodStart": { "type": "string", "format": "date-time" },
        "periodEnd": { "type": "string", "format": "date-time" },
        "searchesUsed": { "type": "integer", "minimum": 0 },
        "comparisonsUsed": { "type": "integer", "minimum": 0 },
        "checkoutsUsed": { "type": "integer", "minimum": 0 },
        "CsvExportsUsed": { "type": "integer", "minimum": 0 },
        "agentTokensUsed": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 1, "description": "Monotonically increasing atomic revision counter" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "periodId",
        "periodStart",
        "periodEnd",
        "searchesUsed",
        "comparisonsUsed",
        "checkoutsUsed",
        "CsvExportsUsed",
        "agentTokensUsed",
        "estimatedCostUsd",
        "revision",
        "updatedAt"
      ]
