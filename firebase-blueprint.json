    "SandboxPaymentEventDoc": {
      "title": "SandboxPaymentEventDoc",
      "description": "Verified PayPal Sandbox webhook event stored at /users/{userId}/sandbox_payment_events/{eventId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "paypal_event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "order_id": { "type": "string", "minLength": 0, "maxLength": 128 },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signature_verified": { "type": "boolean" },
        "processed_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "user_id",
        "paypal_event_id",
        "event_type",
        "signature_verified",
        "processed_at"
      ]
    },
    "PurchaseAuditLogDoc": {
      "title": "PurchaseAuditLogDoc",
      "description": "Immutable autonomous purchasing security audit log stored at /users/{userId}/purchase_audit_logs/{logId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "order_id": { "type": "string", "minLength": 0, "maxLength": 128 },
        "action": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result": { "type": "string", "enum": ["ALLOWED", "BLOCKED", "VERIFIED", "FAILED"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["id", "user_id", "action", "result", "timestamp", "detail"]
    },
    "FeedicoOfferDoc": {
      "title": "FeedicoOfferDoc",
      "description": "Normalized Feedico Partner API coupon/offer record stored at /users/{userId}/feedico_offers/{offerId}",
      "type": "object",
      "properties": {
        "feedico_offer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchant_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "coupon_code": { "type": "string", "minLength": 0, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "discount": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start_date": { "type": "string", "minLength": 0, "maxLength": 64 },
        "expiration_date": { "type": "string", "minLength": 0, "maxLength": 64 },
        "target_countries": { "type": "array", "items": { "type": "string" } },
        "eligibility_conditions": { "type": "array", "items": { "type": "string" } },
        "original_source": { "type": "string", "minLength": 2, "maxLength": 64 },
        "tracked_url": { "type": "string", "minLength": 5, "maxLength": 600 },
        "last_synced_at": { "type": "string", "format": "date-time" },
        "verification_status": {
          "type": "string",
          "enum": ["verified_active", "no_code_deal", "unverified", "expired"]
        }
      },
      "required": [
        "feedico_offer_id",
        "merchant_id",
        "merchant_name",
        "title",
        "description",
        "discount",
        "target_countries",
        "eligibility_conditions",
        "original_source",
        "tracked_url",
        "last_synced_at",
        "verification_status"
      ]
    },
    "AffiliateClickEventDoc": {
      "title": "AffiliateClickEventDoc",
      "description": "Authenticated user affiliate click attribution record stored at /users/{userId}/affiliate_clicks/{clickId}",
      "type": "object",
      "properties": {
        "click_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sub_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "feedico_offer_id": { "type": "string", "minLength": 0, "maxLength": 128 },
        "merchant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchant_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "coupon_code": { "type": "string", "minLength": 0, "maxLength": 128 },
        "tracked_url": { "type": "string", "minLength": 5, "maxLength": 600 },
        "clicked_at": { "type": "string", "format": "date-time" },
        "outcome_status": {
          "type": "string",
          "enum": [
            "CLICK_RECORDED_NOT_PURCHASE",
            "COMMISSION_PENDING",
            "COMMISSION_APPROVED",
            "COMMISSION_DECLINED",
            "COMMISSION_PAID"
          ]
        }
      },
      "required": [
        "click_id",
        "user_id",
        "sub_id",
        "merchant_id",
        "merchant_name",
        "tracked_url",
        "clicked_at",
        "outcome_status"
      ]
    },
    "UserCartDoc": {
      "title": "UserCartDoc",
      "description": "Persistent, user-isolated shopping cart document at /users/{userId}/cart/current with optimistic concurrency revision tracking.",
      "type": "object",
      "properties": {
        "cartId": {
          "type": "string",
          "enum": ["current"]
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "revision": {
          "type": "integer",
          "description": "Monotonically increasing cart revision counter to prevent stale overwrites"
        },
        "itemCount": {
          "type": "integer",
          "description": "Total quantity of items in the cart (0 to 250)"
        },
        "uniqueProductCount": {
          "type": "integer",
          "description": "Number of distinct product+variant line items in the cart (0 to 50)"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "subtotal": {
          "type": "number",
          "description": "Last server-verified merchandise subtotal"
        },
        "verifiedDiscountTotal": {
          "type": "number",
          "description": "Last server-verified coupon discount amount"
        },
        "appliedCouponCode": {
          "type": "string",
          "description": "Active coupon code or empty string when none is applied"
        },
        "itemsJson": {
          "type": "string",
          "description": "Bounded JSON payload of verified CartItem line items including productId, offerId, SKU/variant, selectedOptions, merchant, lastVerifiedPrice, and priceVerifiedAt"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "cartId",
        "userId",
        "revision",
        "itemCount",
        "uniqueProductCount",
        "currency",
        "subtotal",
        "verifiedDiscountTotal",
        "appliedCouponCode",
        "itemsJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedComparisonDoc": {
      "title": "SavedComparisonDoc",
