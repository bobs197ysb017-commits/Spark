# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CHANNEL3_API_KEY: Authorized server-side API key for Channel3 Product Discovery & Commerce API (https://api.trychannel3.com).
# Passed via the `x-api-key` header on server-side requests only. Never exposed to the browser.
CHANNEL3_API_KEY="MY_CHANNEL3_API_KEY"

# PAYPAL SANDBOX & IDENTITY OAUTH 2.0 / OIDC CONFIGURATION:
# Spark tests and development environments strictly require PAYPAL_ENV="sandbox"
# (https://api-m.sandbox.paypal.com and https://www.sandbox.paypal.com/signin/authorize).
# Never expose PAYPAL_CLIENT_SECRET or OAuth tokens to the browser.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_sandbox_webhook_id"
# PAYPAL_REDIRECT_URI / PAYPAL_OIDC_REDIRECT_URI: Exact Return URL registered in PayPal Developer Dashboard (Log in with PayPal -> Advanced Settings).
# Defaults to ${APP_URL}/api/paypal/callback when omitted. Compatible with both Preview URLs and future custom production domains.
PAYPAL_REDIRECT_URI="https://ais-pre-3g5zvurtf6ldxz5u3eoxma-50712932913.europe-west1.run.app/api/paypal/callback"
PAYPAL_OIDC_REDIRECT_URI="https://ais-pre-3g5zvurtf6ldxz5u3eoxma-50712932913.europe-west1.run.app/api/paypal/callback"
PAYPAL_TOKEN_ENCRYPTION_KEY="MY_PAYPAL_TOKEN_ENCRYPTION_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted (Preview or Production domain).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks (/api/paypal/callback), and API endpoints (/api/paypal/connect).
APP_URL="https://ais-pre-3g5zvurtf6ldxz5u3eoxma-50712932913.europe-west1.run.app"

# OPTIONAL LEGACY COUPON FALLBACK (DISABLED BY DEFAULT):
# Spark's primary product discovery and commerce intelligence strategy relies on Channel3 (CHANNEL3_API_KEY).
# Keep FEEDICO_ENABLED="false" unless explicitly testing optional Feedico Partner API coupon lookups.
FEEDICO_ENABLED="false"
